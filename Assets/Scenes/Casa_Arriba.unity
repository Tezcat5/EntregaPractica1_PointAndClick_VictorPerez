  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoInteractuable
  nombreObjeto: Wii
  textoMirar: "YO: Es mi Wii. Qu\xE9 buenos tiempos jugando a esta consola\u2026"
  textoHablar: 'YO: No tiene sentido hablar con una consola...'
  textoInteractuar: 'YO: *Apagas la Wii.*'
  escenaDestino: 
  requiereLlave: 0
  textoSinLlave: "La puerta est\xE1 cerrada. Deber\xEDa hablar con Mam\xE1 primero."
  nombrePuntoEntrada: 
  requiereCartaParaEntrar: 0
  textoSinCarta: "YO: Antes debo revisar el buz\xF3n."
  requiereHablarConMadrePostCarta: 0
  textoSinHablarConMadre: "YO: Primero deber\xEDa ense\xF1arle la carta a Mam\xE1."
  requiereHablarConGuardia: 0
  textoSinHablarConGuardia: "YO: El guardia de la puerta me bloquea el paso. Deber\xEDa hablar con \xE9l."
  requiereTarjetaBus: 0
  nombreTarjetaBus: Tarjeta del Bus
  textoSinTarjetaBus: 'YO: Necesito la Tarjeta del Bus para subir.'
  esLaMadre: 0
  nombreObjetoAEntregarMadre: Llaves de la Casa
  esElGuardia: 0
  textoGuardiaAutorizado: "GUARDIA: Ya te he registrado. Puedes pasar a la Sala del Campe\xF3n."
  esElProfesorJavier: 0
  textoMadreDespuesDeCarta: "MAM\xC1: \xA1A ver!... \xA1Ooh, debes ir a Monlau a enfrentarte al campe\xF3n! \xA1Qu\xE9 suerte! Much\xEDsima suerte, cari\xF1o. Coge la tarjeta del bus de tu cuarto, est\xE1 en el ordenador."
  textoMadreRecordatorioTarjeta: "MAM\xC1: \xA1Much\xEDsima suerte en tu viaje, cari\xF1o! Recuerda coger la tarjeta del bus que est\xE1 al lado del ordenador en tu cuarto."
  entregaObjetoAlInteractuar: 0
  nombreObjetoAEntregar: Llaves de la Casa
  textoYaEntregado: "El buz\xF3n est\xE1 vac\xEDo. Ya cog\xED la carta."
  objetoEstadoAlternativo: {fileID: 1735432937}
  estadoAlternativoActivo: 0
  textoMirarAlternativo: "YO: Es una Wii encendida. Me entran unas ganas tremendas de echar una partida, pero ahora mismo tengo cosas m\xE1s importantes que hacer."
  textoInteractuarAlternativo: 'YO: *Enciendes la Wii.*'
