  m_Script: {fileID: 11500000, guid: c1553fab9ddba0445ae9b4b5236ecf21, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoInteractuable
  nombreObjeto: Casa Vecino
  textoMirar: 'YO: La casa del vecino raro... Siempre tiene las persianas bajadas y la luz apagada. Me da bastante mal rollo.'
  textoHablar: "YO: Ni de broma voy a gritar hacia esa casa, no quiero llamar su atenci\xF3n."
  textoInteractuar: "YO: Intent\xE9 tocar el pomo pero da la sensaci\xF3n de estar bloqueada por dentro. Mejor no insistir..."
  escenaDestino: 
  requiereLlave: 0
  textoSinLlave: "La puerta est\xE1 cerrada. Deber\xEDa hablar con Mam\xE1 primero."
  nombrePuntoEntrada: 
  requiereCartaParaEntrar: 0
  textoSinCarta: "YO: No puedo volver a entrar todav\xEDa, primero debo coger la carta del buz\xF3n."
  requiereHablarConMadrePostCarta: 0
  textoSinHablarConMadre: "YO: Deber\xEDa ir a ense\xF1arle la carta a Mam\xE1 antes de subir a mi habitaci\xF3n."
  requiereHablarConGuardia: 0
  textoSinHablarConGuardia: "YO: El guardia de la puerta me bloquea el paso. Deber\xEDa hablar con \xE9l."
  requiereTarjetaBus: 0
  nombreTarjetaBus: Tarjeta del Bus
  textoSinTarjetaBus: "YO: Necesito la Tarjeta del Bus para viajar. Mam\xE1 me dijo que est\xE1 en mi cuarto, al lado del ordenador."
  esLaMadre: 0
  nombreObjetoAEntregarMadre: Llaves de la Casa
  esElGuardia: 0
  textoGuardiaAutorizado: "GUARDIA: Ya te he registrado. Puedes pasar a la Sala del Campe\xF3n."
  esElProfesorJavier: 0
  textoMadreDespuesDeCarta: "MAM\xC1: \xA1A ver qu\xE9 pone en la carta!... \xA1Ooh, se ve que debes ir a Monlau para enfrentarte al campe\xF3n Pok\xE9mon! Pues much\xEDsima suerte cari\xF1o. Recuerda pillar la tarjeta del bus que est\xE1 en tu cuarto, al lado del ordenador."
  textoMadreRecordatorioTarjeta: "MAM\xC1: Recuerda coger la tarjeta del bus de tu habitaci\xF3n antes de marcharte."
  entregaObjetoAlInteractuar: 0
  nombreObjetoAEntregar: Carta de Monlau
  textoYaEntregado: "El buz\xF3n est\xE1 vac\xEDo. Ya cog\xED la carta."
  objetoEstadoAlternativo: {fileID: 0}
  estadoAlternativoActivo: 0
  textoMirarAlternativo: 
  textoInteractuarAlternativo: 
